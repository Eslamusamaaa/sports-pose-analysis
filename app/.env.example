# Copy to .env and adjust. Relative paths resolve against the karate-ai-web/ root;
# absolute paths (e.g. on D:) are used as-is.
# No secrets belong in this file - local paths and tuning knobs only.

# ---------------------------------------------------------------- OpenPose ----
# CPU build (fallback). Root folder containing bin/ and models/.
# OpenPose MUST be launched with this as its working directory.
OPENPOSE_DIR=third_party/openpose
OPENPOSE_BIN=third_party/openpose/bin/OpenPoseDemo.exe

# GPU build. Auto-preferred for BOTH batch and live when present.
# Kept on D: because C: is nearly full and this build is ~1.2 GB.
OPENPOSE_GPU_DIR=third_party/openpose-gpu
OPENPOSE_PREFER_GPU=true

# Model folder passed to --model_folder. Separate from the OpenPose release
# because the bundled models/getBaseModels.bat downloads from CMU's server,
# which is offline; scripts/download_models.ps1 uses a working mirror.
# Must contain pose/body_25/{pose_deploy.prototxt,pose_iter_584000.caffemodel}
OPENPOSE_MODEL_DIR=models/openpose

# Lower = faster, less accurate. -1 preserves aspect ratio.
OPENPOSE_NET_RESOLUTION=-1x256

# Frame caps. Measured: CPU build ~2.19 s/frame, GPU build ~0.10 s/frame, so a
# cap that is fine on GPU would be a multi-hour CPU run. The active build picks
# which cap applies. 0 = unlimited.
OPENPOSE_MAX_FRAMES=600
# 0 = process the ENTIRE video, no cap.
OPENPOSE_MAX_FRAMES_GPU=0
# No cap means a long clip can run for a while - raise the timeout.
OPENPOSE_TIMEOUT_S=36000

# ---------------------------------------------------- Timeline analysis ----
# Classify overlapping windows so EVERY frame is analysed, instead of
# collapsing the whole clip into one label.
TIMELINE_ENABLED=true
# Ensemble membership. Empty = the vetted default: the two NTU60
# checkpoints (ST-GCN + PoseC3D). The HMDB51/UCF101/Kinetics-400
# checkpoints were MEASURED on real karate footage and returned
# near-random labels (HulaHoop, MoppingFloor, riding unicycle), so
# they are excluded. Re-enable only for single-athlete close-up clips:
#   ENSEMBLE_MODELS=stgcn_ntu60,posec3d_ntu60,posec3d_k400
ENSEMBLE_MODELS=
ENSEMBLE_ENABLED=true

# Person tracker: "centroid" (default) or "bytetrack".
# ByteTrack is fully implemented (Kalman + 3-stage association + gated
# assignment + IoU/distance hybrid cost) but did NOT beat the centroid tracker
# on the available proxy metrics - and those metrics are themselves biased.
# See backend/app/services/bytetrack.py for the measurements. Revisit once
# annotated identities exist to evaluate against.
TRACKER_BACKEND=centroid
TIMELINE_WINDOW=30     # 30 frames = 1 second @30fps (finer time resolution)
TIMELINE_STRIDE=15     # advance 0.5s per window
# 1 = write the BODY_25 overlay video, 0 = JSON only (faster)
OPENPOSE_RENDER_POSE=1

# --------------------------------------------------------------- Real-time ----
REALTIME_CAMERA_INDEX=0
# Capture size. A default-resolution webcam produced ~343 KB JPEGs (~458 KB
# base64); at 12 Hz that saturates the WebSocket and the live view stutters.
REALTIME_CAMERA_RESOLUTION=640x480
# Smaller net resolution than batch: live favours latency over accuracy.
REALTIME_NET_RESOLUTION=-1x192
# Sliding window fed to ST-GCN (the config trains on clip_len=100).
# 30 frames ~= 2s of history at the live rate. 100 meant a 7-SECOND
# window, which buried each strike and made the label lag badly.
REALTIME_WINDOW=30
# Run inference every N frames rather than every frame.
REALTIME_INFER_EVERY=5
# num_clips=1 trades temporal averaging for ~10x lower latency.
REALTIME_NUM_CLIPS=1
REALTIME_MAX_PEOPLE=4
# Ship a rendered frame every Nth frame; keypoints still stream every frame.
REALTIME_JPEG_EVERY=2
# 0 = clean frames; the skeleton is drawn client-side on a canvas.
REALTIME_RENDER_POSE=0
# Fallback camera frame size. The backend measures the real size from the
# rendered JPEG and prefers that, since a wrong img_shape skews PreNormalize2D.
REALTIME_FRAME_HW=480x640

# --------------------------------------------------------------- MMAction2 ----
# Local MMAction2 checkout, used read-only for configs and source.
MMACTION2_DIR=../mmaction2-main

# Interpreter of the isolated MMAction2 venv.
#   CPU venv : third_party/mmaction-venv/Scripts/python.exe
#   CUDA venv (setup_mmaction_cuda_D.ps1 installs it on another drive, e.g. D:/Users/karate-ai-cuda/mmaction-venv/Scripts/python.exe)
# The CUDA venv lives on D: because the cu118 torch wheel is ~2.7 GB and
# expands to ~4 GB, which does not fit on C:.
MMACTION_PYTHON=third_party/mmaction-venv/Scripts/python.exe

# ST-GCN, NTU RGB+D 60, cross-subject, 2D keypoints.
# Declares graph_cfg=dict(layout='coco') -> 17 keypoints, which is why BODY_25
# must be converted. See backend/app/services/skeleton_converter.py.
MMACTION_CONFIG=../mmaction2-main/configs/skeleton/stgcn/stgcn_8xb16-joint-u100-80e_ntu60-xsub-keypoint-2d.py
CHECKPOINT_PATH=models/mmaction/stgcn_8xb16-joint-u100-80e_ntu60-xsub-keypoint-2d_20221129-484a394a.pth
LABEL_MAP_PATH=models/mmaction/label_map_ntu60.txt
MMACTION_TIMEOUT_S=900

# Shown in the UI so a prediction is never displayed without its provenance.
MODEL_NAME=ST-GCN
MODEL_DATASET=NTU RGB+D 60
MODEL_LAYOUT=coco

# ----------------------------------------------------------------- Runtime ----
# cuda:0 or cpu. Applies to the MMAction2 stage. The backend falls back to CPU
# if CUDA is unavailable and always reports the device actually used.
DEVICE=cuda:0

DATA_DIR=data
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_UPLOAD_MB=512
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------- Optional pose engines / re-ID ----
# Defaults point at <repo>/external/* (filled by scripts/download_external.ps1).
# POSE_LIBS_DIR=../external/pose-libs
# YOLO_LIBS_DIR=../external/yolo-libs
# POSE_MODELS_DIR=../external/pose-models
# REID_DIR=backend/reid   # needs osnet_ain_x1_0_msmt17.pth (manual download, optional)
